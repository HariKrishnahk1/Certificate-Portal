# Frontend Configuration
VITE_API_URL=/api

# Google Sheets Configuration (for backend check)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Sheet1

# Private Security Key (Used to generate cryptographic signature of verified certificates)
# You should generate a long random string here for production.
APP_SECRET=your_super_secret_key_here

# Firebase Configuration (Optional: Only if Firebase Storage is preferred over local folder storage)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
